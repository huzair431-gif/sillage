# Copier en .env à la racine. Aucun compte ni secret par défaut.
DATABASE_URL=postgresql://sillage:CHANGE_ME@127.0.0.1:5432/sillage
# Si 5432 est occupé, modifier POSTGRES_PORT et le port de DATABASE_URL ensemble.
POSTGRES_PORT=5432
POSTGRES_USER=sillage
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sillage
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Production : WEB_ORIGIN=https://sillage.example.org ; cookies Secure automatiques.
# Laisser vide pour servir le frontend depuis Nest (même domaine).
VITE_API_URL=
